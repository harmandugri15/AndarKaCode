# Laptop A only. Copy to builder-api/.env and fill in.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/builder_db

# Gateway on Laptop B (Tailscale name or IP).
GATEWAY_URL=http://laptop-b:8787
# Must match GATEWAY_API_KEY in gateway/.env.
GATEWAY_API_KEY=

# Contract Extractor
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
